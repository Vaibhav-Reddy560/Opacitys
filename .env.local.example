# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (provision via Vercel Marketplace: `vercel integration add neon`,
# or npx vercel env pull once linked)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob (private store for uploads/masks/renders)
BLOB_READ_WRITE_TOKEN=

# Groq — free, open-source-model inference (Llama/Qwen/GPT-OSS for text,
# critique narration, Identify, Originality; Whisper for voice-to-text
# transcription). No credit card required at any tier: sign up at
# console.groq.com and generate a key. Free tier is rate-limited
# (roughly 8-12k tokens/min depending on model, ~1k requests/day) — the app
# surfaces a specific message when a call hits that limit.
GROQ_API_KEY=

# Vision pipeline (Phase 1+: SAM 2, depth, inpainting, vectorization — the
# Rebuild module, not yet built). Not used by Critique/Identify/Originality,
# which run their own measurement pass in-process (src/lib/measure) with no
# external vision API. If/when this phase starts: prefer a genuinely
# open-source, self-hosted option (e.g. tesseract.js for OCR) over adding
# another paid dependency here.
REPLICATE_API_TOKEN=
FAL_API_KEY=
