# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (provision via Vercel Marketplace: `vercel integration add neon`,
# or npx vercel env pull once linked)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob (private store for uploads/masks/renders)
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway — used for all Claude calls (critique narration, RAG, etc.)
AI_GATEWAY_API_KEY=

# Deepgram — streaming speech-to-text for voice input (mic button sitewide).
# DEEPGRAM_PROJECT_ID is required to mint short-lived browser tokens.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# Vision pipeline (Phase 1+: SAM 2, depth, inpainting, OCR, vectorization)
REPLICATE_API_TOKEN=
FAL_API_KEY=

# Python analyzer service (Track A deterministic analyzers)
ANALYZER_SERVICE_URL=http://localhost:8000

# Queue (pick one; Inngest shown as default)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
