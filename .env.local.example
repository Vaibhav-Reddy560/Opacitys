# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (provision via Vercel Marketplace: `vercel integration add neon`,
# or npx vercel env pull once linked)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob (private store for uploads/masks/renders)
BLOB_READ_WRITE_TOKEN=

# Session cookie signing (HMAC) — generate with `openssl rand -base64 32`.
# Falls back to an insecure dev-only key if unset in development; required in
# production (see src/lib/auth/token.ts).
SESSION_SECRET=

# Firebase Auth (Google sign-in only — see src/lib/firebase). Client config
# from Firebase console > Project settings > General > Your apps > Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side ID token verification) — from Project settings
# > Service accounts > Generate new private key. FIREBASE_PRIVATE_KEY must
# keep its literal \n escapes; src/lib/firebase/admin.ts un-escapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Groq — free, open-source-model inference (Llama/Qwen/GPT-OSS for text,
# critique narration, Identify, Originality; Whisper for voice-to-text
# transcription). No credit card required at any tier: sign up at
# console.groq.com and generate a key. Free tier is rate-limited
# (roughly 8-12k tokens/min depending on model, ~1k requests/day) — the app
# surfaces a specific message when a call hits that limit.
GROQ_API_KEY=

# Dribbble OAuth (Fingerprint's Portfolio panel — src/lib/portfolio/dribbble.ts).
# All three are independently optional: unset any one and that panel shows
# "Not connected" instead of erroring the page. Register an app at
# dribbble.com/account/applications; the callback is
# <origin>/api/portfolio/dribbble/callback.
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
# Encrypts the stored OAuth token (AES-256-GCM) — generate with
# `openssl rand -base64 32`. See src/lib/crypto.ts.
PORTFOLIO_TOKEN_KEY=

# Google Gemini — REQUIRED by Rebuild for layer detection (the "what is
# this image made of" pass). Free key at https://aistudio.google.com/apikey
# (no credit card). Free tier is 500 requests/day at 10 per minute — one
# request per detection, and detection re-runs after every edit. Used by
# src/lib/rebuild/gemini.ts's detectLayers() (gemini-2.5-flash, bounding-box
# grounding). Gemini's own image-EDITING model (gemini-2.5-flash-image) is
# deliberately NOT used here — it requires a billing-enabled Google Cloud
# project even under the free quota (a card on file, $0 charged), which
# this app avoids entirely. See POLLINATIONS_API_KEY below for editing.
#
# ⚠️ PRIVACY: Google's FREE tier may use submitted content to improve their
# products. Rebuild uploads whatever design you give it. If you are working
# on client material, read Google's current terms and decide deliberately —
# a paid Gemini tier is excluded from that training use.
GEMINI_API_KEY=

# Pollinations.ai — REQUIRED by Rebuild for image EDITING ("Describe
# edits"). Genuinely free, no credit card ever: register at
# https://auth.pollinations.ai to get a token. New accounts start at a
# 0.0000 Pollen balance — editing won't work until you earn some by
# completing free "Quests" at https://enter.pollinations.ai (star the repo,
# use the API a few times, etc; each quest is one-time and non-monetary).
# Detection still works with zero Pollen; only editing needs a balance.
# Used by src/lib/rebuild/pollinations.ts, model "kontext".
POLLINATIONS_API_KEY=

# Not used by any shipped feature — reserved in case a future Rebuild pass
# needs true segmentation masks (SAM 2) rather than bounding boxes.
REPLICATE_API_TOKEN=
